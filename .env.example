# ===========================================================================
# Incident Voice Status Reporter - Environment Configuration Template
# ===========================================================================
# Copy this file to .env and configure as needed for your deployment:
# cp .env.example .env
# NOTE: All default operations run entirely offline with synthetic data.
# No real API keys or paid accounts are required.
# ===========================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development

# Database Configuration (defaults to incident_reporter.db in workspace root)
DB_PATH=incident_reporter.db

# Evidence source mode: fixtures (default) or explicitly configured authorized endpoint.
EVIDENCE_SOURCE=fixtures
# Configure an authorized Grafana datasource proxy URL returning Prometheus instant-query JSON.
# The endpoint must be HTTPS except loopback development. Do not put credentials in its query string.
GRAFANA_PROMETHEUS_QUERY_URL=
GRAFANA_SOURCE_ID=
# Optional bearer token sent only to the configured HTTPS endpoint. Never put it in a URL.
GRAFANA_API_KEY=
GRAFANA_TIMEOUT_SECONDS=5
# JSON object mapping supported names (error_rate, latency_ms, saturation) to authorized PromQL expressions.
# Example only: {"error_rate":"sum(rate(http_requests_total{status=~\"5..\"}[5m]))"}
GRAFANA_METRIC_QUERIES=

# Mock Channel Configuration
DEFAULT_CHANNEL=#incident-response

# Only OFFLINE_MODE=false disables offline mode; missing/invalid values remain offline.
# Live AI also requires LIVE_LLM_ENABLED=true. Browser speech is disabled while offline.
OFFLINE_MODE=true
LIVE_LLM_ENABLED=false
# Protected API routes return 503 until at least one token is configured.
# Generate independent values with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_TOKEN=
ADMIN_TOKEN=

# LLM Tool-Calling Agent
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=12
# Required only for LLM_PROVIDER=openai_compat (for example an OpenAI-compatible API)
LLM_BASE_URL=
# Quota failover; configured only if the primary provider reports quota exhaustion (429).
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
# Optional comma-separated origins; CORS is disabled when empty
CORS_ALLOW_ORIGINS=
# Optional per-scenario replay from LLM_RECORDINGS_PATH; test runs remain offline unless opted in.
DEMO_MODE=false
RECORD_LLM=false
LLM_RECORDINGS_PATH=data/llm_recordings.json
