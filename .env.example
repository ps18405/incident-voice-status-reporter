# ===========================================================================
# Incident Voice Status Reporter - Environment Configuration Template
# ===========================================================================
# Copy this file to .env and configure as needed for your deployment:
# cp .env.example .env
# NOTE: All default operations run entirely offline with synthetic data.
# No real API keys or paid accounts are required.
# ===========================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development

# Database Configuration (defaults to incident_reporter.db in workspace root)
DB_PATH=incident_reporter.db

# Mock Channel Configuration
DEFAULT_CHANNEL=#incident-response

# LLM Tool-Calling Agent (when no key is set, deterministic rules are used)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=12
# Required only for LLM_PROVIDER=openai_compat (for example an OpenAI-compatible API)
LLM_BASE_URL=
# Quota failover; configured only if the primary provider reports quota exhaustion (429).
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
# Optional comma-separated origins; CORS is disabled when empty
CORS_ALLOW_ORIGINS=
# Optional per-scenario replay from LLM_RECORDINGS_PATH; test runs remain offline unless opted in.
DEMO_MODE=false
RECORD_LLM=false
LLM_RECORDINGS_PATH=data/llm_recordings.json
